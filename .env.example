# SWATI — copy to .env and fill in. NEVER commit the real .env.
# All values here are placeholders.

# --- Postgres / TimescaleDB ---
POSTGRES_USER=swati
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=swati
# Used by Prisma + the API (host is the compose service name "db"):
DATABASE_URL=postgresql://swati:CHANGE_ME_STRONG@db:5432/swati?schema=public

# --- Auth (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_HEX

# --- Object storage (MinIO on-box) ---
MINIO_ROOT_USER=swati-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
S3_BUCKET=swati-evidence

# --- Public URL (used for presigned links, CORS, emails) ---
PUBLIC_BASE_URL=https://swati.example.com

# --- IoT device ingest ---
# Shared key that unattended field devices / RTU modems send in the
# `X-Ingest-Key` header to POST /api/ingest/measurements. Leave blank to
# disable the keyed device-push endpoint (it then returns 503); operator apps
# can still ingest with a normal login (data.enter permission).
# Generate with: openssl rand -hex 24
INGEST_API_KEY=
